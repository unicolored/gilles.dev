{
  "name": "gilles.dev",
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "generate-portfolio-data": "ts-node -P script/tsconfig.script.json script/generate-portfolio-data.ts",
    "i18n": "ng extract-i18n gilles.dev --format=xlf --out-file=src/locale/messages.xlf",
    "eslint": "eslint src && eslint projects",
    "check": "npx prettier --check ./src ./projects",
    "format": "npx prettier -w ./src ./projects",
    "set-env": "ts-node src/environments/set-env.ts",
    "deploy": "ngh --dir=dist/gilles.dev/browser",
    "ng": "ng",
    "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 ng serve --hmr false --host 0.0.0.0 --port 4242 --ssl",
    "prebuild": "yarn set-env && ng build ngx-services && yarn generate-portfolio-data",
    "build": "ng build --configuration production --base-href \"/\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:gilles.dev": "node dist/app/server/server.mjs",
    "lint": "ng lint",
    "explore": "ng build --source-map && source-map-explorer dist/app/browser/main* --no-border-checks"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/localize": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/platform-server": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@angular/ssr": "^22.1.8",
    "@tailwindcss/postcss": "^4.3.3",
    "algoliasearch": "^5.59.0",
    "express": "^5.2.1",
    "instantsearch.js": "^4.118.0",
    "rxjs": "~7.8.2",
    "schema-dts": "^2.0.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "tslib": "^2.8.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@cloudinary/ng": "^2.1.6",
    "@cloudinary/url-gen": "^1.22.0",
    "@eslint/js": "^10.0.1",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~7.0.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "ng-packagr": "^22.1.1",
    "postcss": "^8.5.28",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
