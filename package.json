{
  "name": "gilles.dev",
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "i18n": "ng extract-i18n gilles.dev --format=xlf --out-file=src/locale/messages.xlf",
    "eslint": "eslint src && eslint projects",
    "check": "npx prettier --check ./src ./projects",
    "format": "npx prettier -w ./src ./projects",
    "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 ng serve --hmr false --host 0.0.0.0 --port 4242 --ssl",
    "set-env": "ts-node src/environments/set-env.ts",
    "generate-portfolio-data": "ts-node -P script/tsconfig.script.json script/generate-portfolio-data.ts",
    "prebuild": "pnpm run set-env && ng build ngx-services",
    "build": "ng build --configuration production --base-href \"/\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:gilles.dev": "node dist/app/server/server.mjs",
    "lint": "ng lint",
    "explore": "ng build --source-map && source-map-explorer dist/app/browser/main* --no-border-checks"
  },
  "private": true,
  "dependencies": {
    "@angular/cli": "^22.1.8",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/platform-server": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@angular/service-worker": "^22.1.7",
    "@angular/ssr": "^22.1.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "angularx-qrcode": "^22.0.1",
    "meilisearch": "^0.53.0",
    "ngx-sse-client": "^20.0.1",
    "postcss": "^8.5.28",
    "rxjs": "~7.8.2",
    "schema-dts": "^1.1.5",
    "tailwindcss": "^4.3.3",
    "three": "^0.175.0",
    "tslib": "^2.8.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@angular/localize": "^22.1.7",
    "@cloudinary/ng": "^2.1.6",
    "@cloudinary/url-gen": "^1.22.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.25",
    "@types/jasmine": "~5.1.15",
    "@types/node": "^22.20.4",
    "@types/three": "^0.175.0",
    "angular-eslint": "22.5.0",
    "colors": "^1.4.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.11.0",
    "express": "^4.22.3",
    "globals": "^16.5.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.2.1",
    "postcss": "^8.5.3",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.0.8"
  }
}
